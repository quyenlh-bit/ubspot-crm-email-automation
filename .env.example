# ── HubSpot ────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret of your HubSpot app — used to verify webhook signatures (v3)
HUBSPOT_APP_SECRET=your_app_client_secret

# ── Email ──────────────────────────────────────────────────
# ID of the transactional email created in HubSpot (single-send API)
HUBSPOT_TRANSACTIONAL_EMAIL_ID=123456789

# ── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Public base URL HubSpot will call for webhooks (used for logging only)
PUBLIC_BASE_URL=http://localhost:3000

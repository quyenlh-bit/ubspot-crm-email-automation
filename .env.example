# ── Database (required) ────────────────────────────────────
# Postgres / Supabase connection string. Supabase → Project Settings →
# Database → Connection string (URI). Use the pooled connection in prod.
# Local Postgres example: postgres://postgres:postgres@localhost:5432/ubspot
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ubspot

# ── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Public base URL the platform is reachable at; provider webhook signatures
# (e.g. HubSpot v3) are computed over the full request URL.
PUBLIC_BASE_URL=http://localhost:3000

# ── Provider credentials ───────────────────────────────────
# NOTE: provider credentials are NO LONGER global env vars. They live per-tenant
# in the `channel_connections` table (set them via the Connections screen in the
# admin UI, or POST /api/tenants/:id/connections).
#
# The variables below are ONLY read by `npm run db:seed` as a convenience to
# auto-create a HubSpot connection for the demo tenant. Leave blank to skip.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_APP_SECRET=
HUBSPOT_TRANSACTIONAL_EMAIL_ID=
